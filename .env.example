# Copiez ce fichier en .env pour changer les réglages par défaut.
PORT=3000
# 0.0.0.0 = accessible depuis les téléphones et tablettes du même Wi-Fi (connexion obligatoire).
# Mettez 127.0.0.1 pour limiter l’accès à cet ordinateur.
HOST=0.0.0.0

# Génération d'images : pollinations (gratuit, sans clé) ou cloudflare
IMAGE_PROVIDER=pollinations
# Optionnel : clé Pollinations (enter.pollinations.ai) pour retirer le filigrane et la limite
POLLINATIONS_KEY=
# Cloudflare Workers AI (10 000 neurones gratuits / jour)
CF_ACCOUNT_ID=
CF_API_TOKEN=
